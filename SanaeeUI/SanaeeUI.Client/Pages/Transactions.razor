@page "/transactions"
@rendermode InteractiveAuto
@inject ISanaeeDataService Data

<PageTitle>Sanaee Delivery · Transactions</PageTitle>

<PageHeader Title="Transactions" Subtitle="Every ledger movement across all wallets"
            Count="@($"{_filtered.Count} / {_txns.Count}")" />

<MudGrid Class="mb-3">
    <MudItem xs="12" sm="6" md="3">
        <StatCard Title="Deposits" Value="@(_deposit.ToString("N0"))" Icon="@Icons.Material.Filled.AddCircle" Color="Color.Success" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Title="Withdrawals" Value="@(_withdraw.ToString("N0"))" Icon="@Icons.Material.Filled.RemoveCircle" Color="Color.Warning" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Title="Commission" Value="@(_commission.ToString("N0"))" Icon="@Icons.Material.Filled.Percent" Color="Color.Dark" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Title="Refunds" Value="@(_refund.ToString("N0"))" Icon="@Icons.Material.Filled.Undo" Color="Color.Error" />
    </MudItem>
</MudGrid>

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <div class="d-flex flex-wrap gap-3">
        <MudTextField @bind-Value="_search" Placeholder="Search description..." Immediate="true"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:300px;" />
        <MudSelect T="TransactionType?" @bind-Value="_typeFilter" Label="Type" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:220px;">
            @foreach (var t in Enum.GetValues<TransactionType>())
            {
                <MudSelectItem T="TransactionType?" Value="@t">@t.Spaced()</MudSelectItem>
            }
        </MudSelect>
    </div>
</MudPaper>

<MudTable Items="_filtered" Hover="true" Striped="true" Breakpoint="Breakpoint.Md" Elevation="0" Class="sanaee-table" Loading="_loading">
    <HeaderContent>
        <MudTh>#</MudTh>
        <MudTh>Wallet</MudTh>
        <MudTh>Type</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Amount</MudTh>
        <MudTh>Order</MudTh>
        <MudTh>Date</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="#">@context.Id</MudTd>
        <MudTd DataLabel="Wallet">#@context.WalletId</MudTd>
        <MudTd DataLabel="Type"><MudChip T="string" Size="Size.Small" Color="@context.Type.ToColor()">@context.Type.Spaced()</MudChip></MudTd>
        <MudTd DataLabel="Description">@context.Description</MudTd>
        <MudTd DataLabel="Amount">
            <span style="font-weight:600; color:@(context.Amount >= 0 ? "var(--mud-palette-success)" : "var(--mud-palette-error)");">
                @(context.Amount >= 0 ? "+" : "")@context.Amount.ToString("N2")
            </span>
        </MudTd>
        <MudTd DataLabel="Order">@(context.OrderId is null ? "—" : "#" + context.OrderId)</MudTd>
        <MudTd DataLabel="Date">@context.CreatedAt.ToString("dd MMM yyyy HH:mm")</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
    </PagerContent>
</MudTable>

@code {
    private List<WalletTransactionListItem> _txns = new();
    private List<WalletTransactionListItem> _filtered = new();
    private bool _loading = true;
    private string? _search;
    private TransactionType? _typeFilter;
    private decimal _deposit, _withdraw, _commission, _refund;

    protected override async Task OnInitializedAsync()
    {
        _txns = (await Data.GetTransactionsAsync()).OrderByDescending(t => t.CreatedAt).ToList();
        _deposit = _txns.Where(t => t.Type is TransactionType.Deposit or TransactionType.OrderEarning).Sum(t => t.Amount);
        _withdraw = _txns.Where(t => t.Type is TransactionType.Withdrawal or TransactionType.OrderPayment).Sum(t => Math.Abs(t.Amount));
        _commission = _txns.Where(t => t.Type == TransactionType.PlatformCommission).Sum(t => Math.Abs(t.Amount));
        _refund = _txns.Where(t => t.Type == TransactionType.Refund).Sum(t => Math.Abs(t.Amount));
        ApplyFilters();
        _loading = false;
    }

    private void ApplyFilters()
    {
        IEnumerable<WalletTransactionListItem> q = _txns;
        if (_typeFilter is not null) q = q.Where(t => t.Type == _typeFilter);
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(t => t.Description.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));
        _filtered = q.ToList();
    }
}
