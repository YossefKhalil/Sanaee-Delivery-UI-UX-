@page "/customers"
@rendermode InteractiveAuto
@inject ISanaeeDataService Data

<PageTitle>Sanaee Delivery · Customers</PageTitle>

<PageHeader Title="Customers" Subtitle="Registered customers who post service orders"
            Count="@($"{_filtered.Count} / {_customers.Count}")" />

<MudPaper Class="pa-3 mb-3" Elevation="1">
    <MudTextField @bind-Value="_search" Placeholder="Search name, email or phone..." Immediate="true"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
</MudPaper>

<MudTable Items="_filtered" Hover="true" Striped="true" Breakpoint="Breakpoint.Md" Elevation="0" Class="sanaee-table" Loading="_loading">
    <HeaderContent>
        <MudTh>Customer</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Phone</MudTh>
        <MudTh>Orders</MudTh>
        <MudTh>Rating</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Joined</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Customer">
            <div class="d-flex align-center gap-2">
                <EntityAvatar Name="@context.Name" Size="Size.Small" Color="Color.Info" />
                <span>@context.Name</span>
            </div>
        </MudTd>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Phone"><span class="mono">@context.Phone</span></MudTd>
        <MudTd DataLabel="Orders">@context.OrdersCount</MudTd>
        <MudTd DataLabel="Rating">
            @if (context.AverageRating is null)
            {
                <span class="mud-text-secondary">No reviews</span>
            }
            else
            {
                <RatingStars Value="@context.AverageRating.Value" ShowValue="true" />
            }
        </MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Error)">
                @(context.IsActive ? "Active" : "Disabled")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Joined">@context.CreatedAt.ToString("dd MMM yyyy")</MudTd>
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50 }" />
    </PagerContent>
</MudTable>

@code {
    private List<CustomerListItem> _customers = new();
    private List<CustomerListItem> _filtered = new();
    private bool _loading = true;
    private string? _search;

    protected override async Task OnInitializedAsync()
    {
        _customers = (await Data.GetCustomersAsync()).OrderBy(c => c.Name).ToList();
        ApplyFilters();
        _loading = false;
    }

    private void ApplyFilters()
    {
        if (string.IsNullOrWhiteSpace(_search)) { _filtered = _customers.ToList(); return; }
        var t = _search.Trim();
        _filtered = _customers.Where(c =>
            c.Name.Contains(t, StringComparison.OrdinalIgnoreCase) ||
            c.Email.Contains(t, StringComparison.OrdinalIgnoreCase) ||
            c.Phone.Contains(t)).ToList();
    }
}
