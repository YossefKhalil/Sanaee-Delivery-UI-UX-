@namespace SanaeeUI.Client.Shared

<MudAvatar Size="@Size" Color="@Color" Variant="@Variant" Class="@Class"
           Style="@(Color == Color.Default ? "background:var(--sanaee-primary); color:var(--sanaee-on-primary); font-weight:600;" : "font-weight:600;")">
    @Initials
</MudAvatar>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Default;
    [Parameter] public Size Size { get; set; } = Size.Small;
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    [Parameter] public string? Class { get; set; }

    private string Initials =>
        string.IsNullOrWhiteSpace(Name)
            ? "?"
            : string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                .Take(2)
                                .Select(p => char.ToUpper(p[0])));
}
