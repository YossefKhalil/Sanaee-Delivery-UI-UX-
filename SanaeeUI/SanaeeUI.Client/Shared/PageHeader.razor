@namespace SanaeeUI.Client.Shared

<div class="d-flex flex-wrap align-center justify-space-between mb-4 gap-2">
    <div>
        <MudText Typo="Typo.h5" Style="font-weight:700;">@Title</MudText>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Subtitle</MudText>
        }
    </div>
    <div class="d-flex align-center gap-2">
        @if (Count is not null)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@Count</MudChip>
        }
        @Actions
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Count { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
