@namespace SanaeeUI.Client.Shared

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-3">
            <MudAvatar Color="Color.Primary">@Initials(Provider.Name)</MudAvatar>
            <div>
                <MudText Typo="Typo.h6">@Provider.Name</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Provider #@Provider.Id · User #@Provider.UserId</MudText>
            </div>
            <MudChip T="string" Size="Size.Small" Color="@Provider.Status.ToColor()">@Provider.Status.Spaced()</MudChip>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-3" Outlined="true">
                    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-2">Profile</MudText>
                    <DetailRow Label="National number" Value="@Provider.NationalNumber" />
                    <DetailRow Label="Rating" Value="@($"{Provider.AverageRating} ★ ({Provider.TotalReviewCount} reviews)")" />
                    <DetailRow Label="Completed orders" Value="@Provider.CompletedOrders.ToString()" />
                    <DetailRow Label="Availability" Value="@(Provider.IsAvailable ? "Online" : "Offline")" />
                </MudPaper>

                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-4 mb-1">Skills</MudText>
                @if (Skills.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No skills registered.</MudText>
                }
                @foreach (var s in Skills)
                {
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.body2">@s.Category</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@s.YearsOfExperience yrs</MudText>
                    </div>
                }
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-1">KYC documents</MudText>
                @foreach (var d in Documents)
                {
                    <div class="d-flex align-center justify-space-between py-1">
                        <MudText Typo="Typo.body2">@d.Type.Spaced()</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@d.Status.ToColor()">@d.Status.Spaced()</MudChip>
                    </div>
                }

                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mt-4 mb-1">Recent reviews</MudText>
                @if (Reviews.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">No reviews yet.</MudText>
                }
                @foreach (var r in Reviews.Take(3))
                {
                    <MudPaper Class="pa-2 mb-2" Outlined="true">
                        <MudRating SelectedValue="@r.Rating" ReadOnly="true" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@r.Comment</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@r.Reviewer · @r.CreatedAt.ToString("dd MMM yyyy")</MudText>
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close(DialogResult.Ok(true)))">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ProviderListItem Provider { get; set; } = default!;
    [Parameter] public List<ProviderDocumentListItem> Documents { get; set; } = new();
    [Parameter] public List<ProviderCategoryListItem> Skills { get; set; } = new();
    [Parameter] public List<ReviewListItem> Reviews { get; set; } = new();

    private static string Initials(string name) =>
        string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpper(p[0])));
}
